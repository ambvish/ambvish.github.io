{% from "macros/window.njk" import window with context %}
{% from "macros/draft.njk" import badge %}
{% call window({ id: "research", title: "Research", tools: "research", active: true }) %}
  <div id="research-list">
    {%- for group, items in desk.research | groupby("group") %}
    <div class="list__group" data-filter-group>
      <h3 class="people__label">{{ group }}</h3>
      <ul class="people">
        {%- for item in items %}
        <li data-filter-item data-tags="{{ group }}">
          <a class="person" href="/research/{{ item.slug }}/" data-open-article="research-{{ item.slug }}" data-search="{{ item.title }}" data-kind="Research" data-detail="{{ item.headline }}" title="{{ item.title }}">
            <img class="person__avatar" src="{{ item.image }}" width="240" height="240" alt="" draggable="false">
            <span class="person__name">{{ item.short }}{{ badge(item, "status") }}</span>
          </a>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
  <p class="list__empty" data-filter-empty hidden>No matches.</p>
{% endcall %}
