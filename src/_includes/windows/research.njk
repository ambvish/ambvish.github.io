{% from "macros/window.njk" import window with context %}
{% from "macros/draft.njk" import badge %}
{% call window({ id: "research", title: "Research", tools: "research", active: true }) %}
  <div id="research-list">
    {%- for group, items in desk.research | groupby("group") %}
    <div class="list__group" data-filter-group>
      <h3 class="list__label">{{ group }}</h3>
      <ul class="list">
        {%- for item in items %}
        <li class="row" data-filter-item>
          <a class="row__link" href="/research/{{ item.slug }}/" data-open-article="research-{{ item.slug }}" data-search="{{ item.title }}" data-kind="Research" data-detail="{{ item.headline }}">
            {% include "icons/doc.njk" %}
            <span class="row__main">
              <span class="row__title">{{ item.title }}{{ badge(item, "status") }}</span>
              <span class="row__excerpt">{{ item.subtitle }}</span>
            </span>
          </a>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
  <p class="list__empty" data-filter-empty hidden>No matches.</p>
{% endcall %}
