{% from "macros/window.njk" import window with context %}
{% from "macros/draft.njk" import badge %}
{% call window({ id: "education", title: "Education" }) %}
  <h3 class="list__label">Schools</h3>
  <ul class="list">
    {%- for school in desk.schools %}
    <li class="row" data-search="{{ school.name }}" data-kind="Education" data-detail="{{ school.degree }}">
      <div class="row__link row__link--static">
        {% include "icons/cap.njk" %}
        <span class="row__main">
          <span class="row__head">
            <span class="row__title">{{ school.name }}</span>
            {%- if school.dates %}<span class="row__date">{{ school.dates }}{{ badge(school, "dates") }}</span>{% endif %}
          </span>
          <span class="row__excerpt row__excerpt--full row__excerpt--strong">{{ school.degree }}</span>
          {%- if school.minor %}<span class="row__excerpt row__excerpt--full row__excerpt--strong">{{ school.minor }}</span>{% endif %}
          {%- if school.note %}<span class="row__excerpt row__excerpt--full">{{ school.note }}</span>{% endif %}
          <span class="chips">{% for activity in school.activities %}<span class="chip">{{ activity }}</span>{% endfor %}</span>
        </span>
      </div>
    </li>
    {%- endfor %}
  </ul>
  <h3 class="list__label">Certifications &amp; scores</h3>
  <ul class="posters">
    {%- for cert in desk.certifications %}
    <li class="poster poster--{{ loop.index0 % 5 }}{% if cert.draft %} is-draft{% endif %}" data-search="{{ cert.name }}" data-kind="Certification" data-detail="{{ cert.issuer }}">
      <span class="poster__issuer">{{ cert.issuer }}</span>
      <span class="poster__name">{{ cert.name }}</span>
      <span class="poster__date">{{ cert.date }}{{ badge(cert) }}</span>
    </li>
    {%- endfor %}
  </ul>
{% endcall %}
