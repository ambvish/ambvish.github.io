{# A small Minesweeper (src/assets/js/game.js). Without JavaScript it just says so. #}
{% from "macros/window.njk" import window with context %}
{% call window({ id: "game", title: "Minesweeper" }) %}
  <div class="mines" data-mines>
    <p class="mines__fallback" data-mines-fallback>Turn on JavaScript to play.</p>
    <div class="mines__board" data-mines-board hidden>
      <div class="mines__bar">
        <span class="mines__counter" data-mines-left aria-label="Mines left">010</span>
        <button class="mines__face" type="button" data-mines-face aria-label="New game">🙂</button>
        <span class="mines__counter" data-mines-time aria-label="Seconds">000</span>
      </div>
      <div class="mines__grid" role="grid" aria-label="Minefield, 9 by 9, 10 mines. Arrow keys move, Enter reveals, F flags." data-mines-grid></div>
      <div class="mines__foot">
        <button class="mines__mode" type="button" data-mines-flag aria-pressed="false">🚩 Flag mode</button>
        <p class="mines__status" data-mines-status role="status" aria-live="polite">Clear the field. Right-click or F to flag.</p>
      </div>
    </div>
  </div>
{% endcall %}
