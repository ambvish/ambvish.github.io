{# Only exists on the local dev server: every quote is waiting for the professor's permission. #}
{% from "macros/window.njk" import window with context %}
{% from "macros/draft.njk" import badge %}
{% if desk.letters.length %}
{% call window({ id: "letters", title: "Letters", startClosed: true }) %}
  <ul class="list">
    {%- for letter in desk.letters %}
    <li class="row is-draft">
      <div class="row__link row__link--static">
        {% include "icons/quote.njk" %}
        <span class="row__main">
          <span class="quote">“{{ letter.quote }}”</span>
          <span class="row__excerpt row__excerpt--full">— {{ letter.by }}{% if letter.title %}, {{ letter.title }}{% endif %} {{ badge(letter) }}</span>
        </span>
      </div>
    </li>
    {%- endfor %}
  </ul>
{% endcall %}
{% endif %}
