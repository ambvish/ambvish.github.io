{% from "macros/window.njk" import window with context %}
{% from "macros/draft.njk" import badge %}
{% call window({ id: "projects", title: "Projects", tools: "projects" }) %}
  <ul class="cards" id="projects-list" data-view="grid">
    {%- for project in desk.projects %}
    <li class="card card--{{ project.tags[0] | tone }}{% if project.draft %} is-draft{% endif %}" data-filter-item data-tags="{{ project.tags | join('|') }}">
      <a class="card__link" href="/projects/{{ project.slug }}/" data-open-article="projects-{{ project.slug }}" data-search="{{ project.name }}" data-kind="Project" data-detail="{{ project.summary }}">
        <span class="card__cover" aria-hidden="true">
          <span class="card__cover-name">{{ project.name }}</span>
          <span class="card__cover-summary">{{ project.summary }}</span>
          <span class="card__cover-tags">{{ project.tags | join(" · ") }}</span>
          <span class="card__initial">{{ project.name | first }}</span>
        </span>
        <span class="card__body">
          <span class="card__name">{{ project.name }}</span>
          <span class="card__summary">{{ project.summary }}</span>
          {%- if project.credit %}<span class="card__meta">{{ project.credit }}{{ badge(project) }}</span>{% endif %}
        </span>
      </a>
    </li>
    {%- endfor %}
  </ul>
  <p class="list__empty" data-filter-empty hidden>No projects with that tag yet.</p>
{% endcall %}
