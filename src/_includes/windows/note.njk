{% from "macros/draft.njk" import badge %}
<aside class="note" id="note" data-window data-drag-handle data-title="About me" tabindex="-1" aria-label="About me">
  <figure class="note__photo">
    <img src="{{ site.photo }}" width="400" height="500" alt="{{ site.name }}" draggable="false">
  </figure>
  {#- Intro paragraphs are trusted HTML from src/_data/site.json (for the inline link). #}
  {%- for paragraph in site.intro.paragraphs %}
  <p>{{ paragraph | safe }}</p>
  {%- endfor %}
  {%- if desk.intro and desk.intro.lookingFor %}
  <p><strong>Looking for:</strong> {{ desk.intro.lookingFor }} {{ badge(desk.intro) }}</p>
  {%- endif %}
  <p class="note__links">
    <a href="{{ site.links.github }}" target="_blank" rel="noopener noreferrer" data-search="GitHub" data-kind="Link">GitHub<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    <span aria-hidden="true">·</span>
    <a href="{{ site.links.linkedin }}" target="_blank" rel="noopener noreferrer" data-search="LinkedIn" data-kind="Link">LinkedIn<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
    <span aria-hidden="true">·</span>
    <a href="mailto:{{ site.email }}" data-copy-email="{{ site.email }}" data-search="Email" data-kind="Link">Email</a>
    <span aria-hidden="true">·</span>
    <a href="{{ site.resume }}" data-search="Résumé" data-kind="PDF">Résumé<span class="visually-hidden"> (PDF)</span></a>
  </p>
  <p class="note__hint" data-js-only hidden><kbd data-modkey>⌘</kbd> <kbd>K</kbd> to search.</p>
  <p class="note__toast" data-email-toast role="status" aria-live="polite" hidden></p>
</aside>
