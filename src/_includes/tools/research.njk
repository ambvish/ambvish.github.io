<label class="visually-hidden" for="research-filter">Search research</label>
<span class="search"><input id="research-filter" type="search" placeholder="Search" data-filter="research-list" data-filter-mode="text" autocomplete="off"></span>
<label class="visually-hidden" for="research-group">Show</label>
<span class="select"><select id="research-group" data-filter="research-list" data-filter-mode="tag">
  <option value="">All</option>
  {%- for group, items in desk.research | groupby("group") %}
  <option value="{{ group }}">{{ group }}</option>
  {%- endfor %}
</select></span>
