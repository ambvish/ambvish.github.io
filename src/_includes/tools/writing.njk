<label class="visually-hidden" for="writing-filter">Search writing</label>
<span class="search"><input id="writing-filter" type="search" placeholder="Search" data-filter="writing-list" data-filter-mode="text" autocomplete="off"></span>
<label class="visually-hidden" for="writing-status">Show</label>
<span class="select"><select id="writing-status" data-filter="writing-list" data-filter-mode="tag">
  <option value="">All</option>
  <option value="published">Published</option>
  <option value="up-next">Up next</option>
</select></span>
