{% from "macros/draft.njk" import badge %}
<article class="article{% if item.draft %} is-draft{% endif %}">
  <p class="article__kicker">{{ item.org }}{% if item.product %} · {{ item.product }}{% endif %} {{ badge(item) }}</p>
  <h3 class="article__title">{{ item.headline }}</h3>
  <p class="article__meta">
    {%- if item.role %}<span>{{ item.role }}{{ badge(item, "role") }}</span>{% endif -%}
    {%- if item.dates %}<span>{{ item.dates }}{{ badge(item, "dates") }}</span>{% endif -%}
    {%- if item.location %}<span>{{ item.location }}</span>{% endif -%}
  </p>
  {% if item.funding %}<p>{{ item.role }} {{ item.funding }}.</p>{% endif %}
  {% if item.lede %}<p class="article__lede">{{ item.lede }}</p>{% endif %}
  {% if item.team %}<p><strong>Team project.</strong>{{ badge(item, "teamNames") }}</p>{% endif %}
  {% for detail in item.details %}
  <p>{% if item.detailsLabel and loop.first %}<strong>{{ item.detailsLabel }}:</strong> {% endif %}{{ detail }}</p>
  {% endfor %}
  {% if item.bullets %}
  <ul>
    {% for bullet in item.bullets %}<li><strong>{{ bullet.name }}:</strong> {{ bullet.text }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if item.scale %}<p><strong>Scale:</strong> {{ item.scale }}{{ badge(item, "scale") }}</p>{% endif %}
  {% if item.link %}
  <p><a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.linkLabel }}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></p>
  {% endif %}
  {% if item.tags %}
  <ul class="tags" aria-label="Tags">{% for tag in item.tags %}<li>{{ tag }}</li>{% endfor %}</ul>
  {% endif %}
</article>
