<header class="menubar">
  <a class="menubar__brand" href="/">{% include "icons/logo.njk" %}<span>{{ site.name }}</span></a>
  <nav class="menubar__menu" aria-label="Windows">
    <a href="/#experience" data-open-window="experience">Experience</a>
    <a href="/#projects" data-open-window="projects">Projects</a>
    <a href="/#research" data-open-window="research">Research</a>
    <a href="/#skills" data-open-window="skills">Skills</a>
    <a href="/#education" data-open-window="education">Education</a>
    <a href="/#writing" data-open-window="writing">Writing</a>
    {%- if desk.letters.length %}
    <a href="/#letters" data-open-window="letters">Letters</a>
    {%- endif %}
  </nav>
  <div class="menubar__right">
    <button class="menubar__search" type="button" data-open-palette aria-label="Search" aria-keyshortcuts="Meta+K Control+K" hidden>{% include "icons/search.njk" %}</button>
    <time class="menubar__clock" data-clock hidden></time>
  </div>
</header>
