<dialog class="palette" data-palette aria-label="Search">
  <div class="palette__field">
    {% include "icons/search.njk" %}
    <input class="palette__input" data-palette-input type="text" role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list" aria-label="Search the site" placeholder="Search work, research, projects, skills…" autocomplete="off" spellcheck="false">
  </div>
  <ul class="palette__results" id="palette-results" role="listbox" aria-label="Results" data-palette-results></ul>
  <p class="palette__empty" data-palette-empty hidden>No matches.</p>
  <p class="palette__hint"><kbd>↑</kbd> <kbd>↓</kbd> to move · <kbd>Enter</kbd> to open · <kbd>Esc</kbd> to close</p>
</dialog>
