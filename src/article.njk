---
layout: layouts/base.njk
pagination:
  data: desk.articles
  size: 1
  alias: article
permalink: "/{{ article.kind }}/{{ article.slug }}/"
eleventyComputed:
  title: "{{ article.title }} · Vishnuteja Ambati"
  description: "{{ (article.item.lede or article.item.summary or article.item.details[0] or article.item.quote or article.item.headline) | truncate(155) }}"
---
{% from "macros/window.njk" import window with context %}
{% set item = article.item %}
<main class="desk desk--single{% if article.wide %} desk--wide{% endif %}" id="desk" data-desk>
  <h1 class="visually-hidden">{{ article.title }}</h1>
  {% call window({ id: "article", title: article.windowTitle, active: true }) %}
    {% include "partials/article-" + article.kind + ".njk" %}
    <p class="article__back"><a href="/#{{ article.kind }}">← Back to the desktop</a></p>
  {% endcall %}
</main>
